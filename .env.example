# Kalshi API Credentials
KALSHI_EMAIL=your_email@example.com
KALSHI_PASSWORD=your_password
KALSHI_API_KEY=your_api_key
KALSHI_PRIVATE_KEY_PATH=/path/to/private_key.pem
KALSHI_MODE=demo  # demo or prod

# Polymarket Credentials
POLYMARKET_PRIVATE_KEY=0x...
POLYMARKET_API_KEY=your_api_key
POLYMARKET_API_SECRET=your_api_secret
POLYMARKET_CHAIN_ID=137  # Polygon mainnet

# Trading Parameters
ENABLE_TRADING=false  # Set to true to enable real trading
MIN_PROFIT_THRESHOLD=0.02  # 2% minimum profit
MAX_POSITION_SIZE=100.00  # Maximum USD per position
MAX_TOTAL_EXPOSURE=1000.00  # Maximum total exposure
CHECK_INTERVAL=5.0  # Seconds between market checks

# Risk Management
MAX_DAILY_LOSS=100.00
MAX_DRAWDOWN=0.20  # 20% max drawdown
STOP_LOSS_ENABLED=true

# Fees (as decimals)
KALSHI_FEE_RATE=0.00  # Currently 0%
POLYMARKET_FEE_RATE=0.02  # Estimated 2% including gas

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/arbitrage_bot.log

# Database
DATABASE_URL=sqlite:///data/trades.db

# Monitoring (optional)
ENABLE_ALERTS=false
ALERT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
